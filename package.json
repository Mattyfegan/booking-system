{
  "name": "booking-system",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @booking/db generate",
    "db:migrate": "pnpm --filter @booking/db migrate",
    "db:seed": "pnpm --filter @booking/db seed",
    "db:studio": "pnpm --filter @booking/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0"
}
