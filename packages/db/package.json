{
  "name": "@booking/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "seed": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "studio": "node --env-file=../../.env node_modules/prisma/build/index.js studio",
    "lint": "tsc --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
